# ==========================================
# Cart Rescue — Environment Configuration
# ==========================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cartrescue
POSTGRES_USER=cartrescue
POSTGRES_PASSWORD=cartrescue_secret

# Redis (Feature Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Business Events)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ML Service (FastAPI)
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# Backend (Spring Boot)
BACKEND_HOST=localhost
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080

# Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Notification Providers (Mock by default — replace with real keys)
SENDGRID_API_KEY=mock
TWILIO_ACCOUNT_SID=mock
TWILIO_AUTH_TOKEN=mock
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_PROJECT_ID=mock

# ML Model Configuration
MODEL_VERSION=1.0.0
RISK_THRESHOLD=0.7
MAX_DISCOUNT_PCT=15
DEFAULT_CAMPAIGN_BUDGET=100000
